---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const lastUpdated = "August 30, 2026";
---

<Layout
  title="Terms of Service — Pétale Flower Boutique"
  description="Terms of Service for Pétale Flower Boutique. Ordering policies, Santiago delivery terms, seasonal flower substitution rules, and freshness guarantees for our mockup boutique."
>
  <Navbar isSubpage={true} />

  <main class="min-h-screen pt-28 pb-20 bg-cream relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-20 left-0 w-96 h-96 bg-sage-light/25 rounded-full blur-3xl pointer-events-none -translate-y-12 -translate-x-1/3"></div>
    <div class="absolute top-1/2 right-0 w-96 h-96 bg-blush-light/25 rounded-full blur-3xl pointer-events-none translate-x-1/3"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs md:text-sm text-charcoal-light/60 mb-6 font-medium" aria-label="Breadcrumb">
        <a href={base} class="hover:text-sage-dark transition-colors">Home</a>
        <span class="text-charcoal-light/30">/</span>
        <span class="text-charcoal font-semibold">Terms of Service</span>
      </nav>

      <!-- Page Header -->
      <div class="text-center sm:text-left pb-10 border-b border-cream-dark">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sage/10 text-sage-dark text-xs font-semibold tracking-wider uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-sage animate-pulse"></span>
          Mockup Boutique Document
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-charcoal tracking-tight mb-4">
          Terms of <span class="italic text-sage-dark">Service</span>
        </h1>
        <p class="text-charcoal-light/80 text-base sm:text-lg max-w-2xl leading-relaxed">
          Standard operational conditions, fresh floral delivery rules, substitution guidelines, and subscription policies for Pétale Flower Boutique.
        </p>
        <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-charcoal-light/60 mt-4 pt-4 border-t border-cream-dark/60">
          <span><strong>Effective Date:</strong> January 1, 2026</span>
          <span>•</span>
          <span><strong>Last Revised:</strong> {lastUpdated}</span>
          <span>•</span>
          <span><strong>Status:</strong> Portfolio Demonstration (Mockup)</span>
        </div>
      </div>

      <!-- Prominent Mockup Disclaimer Banner -->
      <div class="my-8 p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50/60 border border-amber-200/80 shadow-sm flex flex-col sm:flex-row gap-4 items-start">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-sm sm:text-base font-bold text-amber-900 tracking-tight">
            Demonstration Mockup Notice
          </h2>
          <p class="text-xs sm:text-sm text-amber-800/90 leading-relaxed">
            This document represents a <strong>mockup agreement</strong> for the conceptual flower boutique website <em>Pétale</em>. It is crafted to illustrate modern, thoughtful e-commerce and retail terms for a luxury florist. No legal obligations or binding contracts exist.
          </p>
        </div>
      </div>

      <!-- Quick Navigation Index / Jump Pills -->
      <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-5 border border-cream-dark/80 shadow-sm mb-12">
        <p class="text-xs font-bold uppercase tracking-wider text-charcoal-light/70 mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
          </svg>
          Quick Navigation
        </p>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="#acceptance" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">1. Mockup Acceptance</a>
          <a href="#botanicals" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">2. Seasonal Floral Nature</a>
          <a href="#substitutions" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">3. Substitution Policy</a>
          <a href="#delivery" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">4. Santiago Deliveries</a>
          <a href="#freshness" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">5. Freshness Guarantee</a>
          <a href="#subscriptions" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">6. Floral Subscriptions</a>
          <a href="#events" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">7. Weddings & Events</a>
          <a href="#jurisdiction" class="px-3 py-1.5 rounded-lg bg-cream hover:bg-sage/15 text-charcoal-light hover:text-sage-dark transition-colors">8. Governing Law</a>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="space-y-10 text-charcoal leading-relaxed text-sm sm:text-base">

        <!-- Section 1 -->
        <section id="acceptance" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">1</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Acceptance & Mockup Scope</h2>
          </div>
          <p class="text-charcoal-light/80 mb-3 leading-relaxed">
            By interacting with Pétale, you acknowledge that this website is an interactive prototype designed to demonstrate front-end craftsmanship, brand storytelling, and user experience.
          </p>
          <p class="text-charcoal-light/80 leading-relaxed">
            Any product representations, delivery options, and pricing structures are artistic depictions created for conceptual visualization.
          </p>
        </section>

        <!-- Section 2 -->
        <section id="botanicals" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">2</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Floral Products & Natural Variations</h2>
          </div>
          <p class="text-charcoal-light/80 mb-4 leading-relaxed">
            Flowers are natural living creations. Because weather conditions, harvest cycles, and botanical life vary:
          </p>
          <ul class="space-y-3 text-charcoal-light/90 pl-1">
            <li class="flex items-start gap-3">
              <span class="text-sage font-bold text-lg leading-none">✿</span>
              <div>
                <strong class="text-charcoal">Uniqueness of Every Stem:</strong> Slight differences in petal hue, bloom diameter, foliage density, and stem curvature are natural signs of authentic, fresh-cut flowers.
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sage font-bold text-lg leading-none">✿</span>
              <div>
                <strong class="text-charcoal">Opening Stages:</strong> Blooms such as Ecuadorian roses and Dutch peonies may be delivered partially in tight bud to guarantee longevity and allow the recipient to experience their full opening process.
              </div>
            </li>
          </ul>
        </section>

        <!-- Section 3 -->
        <section id="substitutions" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">3</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Artisanal Substitution Policy</h2>
          </div>
          <p class="text-charcoal-light/80 mb-3 leading-relaxed">
            Occasionally, extreme climate or flight arrivals from our international farm partners (e.g. Holland, Thailand, Ecuador) may temporarily delay specific rare stems.
          </p>
          <div class="p-4 rounded-xl bg-cream/70 border border-cream-dark text-xs sm:text-sm text-charcoal-light/90 space-y-2">
            <p>
              <strong>Master Florist Discretion:</strong> When an exact flower variety is unavailable, our master florists will select an alternative bloom of <em>equal or higher monetary value</em> that preserves the bouquet's aesthetic, color harmony, and silhouette.
            </p>
            <p>
              <strong>Vases & Wrapping:</strong> In the event a specific container or ribbon is out of stock, we provide an equivalent luxury vessel matching the overall style.
            </p>
          </div>
        </section>

        <!-- Section 4 -->
        <section id="delivery" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">4</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Santiago Metropolitan Delivery Terms</h2>
          </div>
          <p class="text-charcoal-light/80 mb-4 leading-relaxed">
            Our delivery logistics are modeled around the metropolitan reality of Santiago, Chile:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-soft-white border border-cream-dark">
              <span class="block text-xs font-bold uppercase tracking-wider text-sage-dark mb-1">Same-Day Cutoff</span>
              <p class="text-xs text-charcoal-light/75 leading-relaxed">
                Orders placed before 2:00 PM CLT qualify for same-day delivery across Las Condes, Providencia, Vitacura, Ñuñoa, and Santiago Centro.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-soft-white border border-cream-dark">
              <span class="block text-xs font-bold uppercase tracking-wider text-sage-dark mb-1">Building Concierge (Conserjería)</span>
              <p class="text-xs text-charcoal-light/75 leading-relaxed">
                For residential apartment buildings, couriers may leave bouquets with building reception/concierge if the recipient is momentarily unavailable.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-soft-white border border-cream-dark">
              <span class="block text-xs font-bold uppercase tracking-wider text-sage-dark mb-1">Extreme Weather & Heat</span>
              <p class="text-xs text-charcoal-light/75 leading-relaxed">
                During high summer temperatures in Santiago, arrangements are transported in climate-conditioned vehicles with hydrated foam bases.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-soft-white border border-cream-dark">
              <span class="block text-xs font-bold uppercase tracking-wider text-sage-dark mb-1">Address Accuracy</span>
              <p class="text-xs text-charcoal-light/75 leading-relaxed">
                The purchaser is responsible for supplying exact comuna, street number, and contact telephone numbers to prevent delivery delays.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 5 -->
        <section id="freshness" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">5</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">7-Day Freshness Guarantee & Perishability</h2>
          </div>
          <p class="text-charcoal-light/80 mb-3 leading-relaxed">
            We stand behind every stem. Under our simulated quality guarantee, fresh floral arrangements are assured to thrive for at least 7 days when basic care guidelines are followed (cutting stems at 45°, renewing fresh water, and avoiding direct sunlight).
          </p>
          <p class="text-charcoal-light/80 text-xs sm:text-sm leading-relaxed">
            <strong>Fresh Flower Claims:</strong> If flowers arrive damaged or wilt prematurely within 48 hours of dispatch, customers can send a photo to our studio team for immediate complimentary replacement.
          </p>
        </section>

        <!-- Section 6 -->
        <section id="subscriptions" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">6</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Weekly & Corporate Subscriptions</h2>
          </div>
          <p class="text-charcoal-light/80 mb-3 leading-relaxed">
            For residences and corporate ateliers in Santiago, subscriptions provide curated rotating blooms:
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-charcoal-light/80 pl-1">
            <li class="flex items-start gap-2">
              <span class="text-sage font-bold">•</span>
              <span><strong>Flexibility:</strong> Subscriptions can be paused, modified, or canceled up to 48 hours before the scheduled weekly dispatch date.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sage font-bold">•</span>
              <span><strong>Vase Exchange:</strong> Subscriptions include our signature ceramic and fluted glass vases, sanitized and swapped with every delivery.</span>
            </li>
          </ul>
        </section>

        <!-- Section 7 -->
        <section id="events" class="bg-white rounded-2xl p-6 sm:p-8 border border-cream-dark/80 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage/10 text-sage-dark font-serif font-bold text-sm flex items-center justify-center">7</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Weddings & Bespoke Event Contracts</h2>
          </div>
          <p class="text-charcoal-light/80 leading-relaxed mb-3">
            Custom event installations require specialized sourcing and dedicated artisan labor. In a real-world setting, event contracts require a non-refundable booking deposit to reserve harvest dates and design studio schedules.
          </p>
        </section>

        <!-- Section 8 -->
        <section id="jurisdiction" class="bg-gradient-to-br from-soft-white to-cream rounded-2xl p-6 sm:p-8 border border-sage/20 shadow-sm scroll-mt-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-sage text-white font-serif font-bold text-sm flex items-center justify-center">8</div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-charcoal">Governing Law & Mockup Attributions</h2>
          </div>
          <p class="text-charcoal-light/80 leading-relaxed mb-3 text-xs sm:text-sm">
            These mock terms reference the laws of the Republic of Chile and the jurisdiction of the courts of Santiago for thematic authenticity.
          </p>
          <div class="text-xs text-charcoal-light/70 space-y-1 pt-2 border-t border-cream-dark/80">
            <p><strong>Design System:</strong> Pétale Premium Florist UI</p>
            <p><strong>Portfolio Creator:</strong> Designed and developed by 0x5</p>
            <p><strong>Questions:</strong> Contact <a href="mailto:terms@petale-flores.mockup" class="text-sage-dark underline hover:text-sage">terms@petale-flores.mockup</a></p>
          </div>
        </section>
      </div>

      <!-- Action Footer Navigation -->
      <div class="mt-12 pt-8 border-t border-cream-dark flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href={base}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-cream-dark text-charcoal font-semibold text-xs tracking-wider uppercase hover:border-sage hover:text-sage-dark transition-all duration-300 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Return to Home
        </a>

        <div class="flex items-center gap-4 text-xs font-semibold tracking-wider uppercase">
          <span class="text-charcoal-light/50">Related:</span>
          <a
            href={`${base}/privacy`}
            class="text-sage-dark hover:text-sage transition-colors underline"
          >
            View Privacy Policy →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
