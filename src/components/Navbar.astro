---
// Navbar component with glassmorphism effect
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group" id="nav-logo">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blush to-sage flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
          </svg>
        </div>
        <span class="font-serif text-2xl font-bold tracking-tight">Pétale</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#flowers" class="nav-link text-sm font-medium tracking-wide uppercase hover:text-sage-dark transition-colors duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-sage after:transition-all after:duration-300 hover:after:w-full">Our Flowers</a>
        <a href="#about" class="nav-link text-sm font-medium tracking-wide uppercase hover:text-sage-dark transition-colors duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-sage after:transition-all after:duration-300 hover:after:w-full">About</a>
        <a href="#services" class="nav-link text-sm font-medium tracking-wide uppercase hover:text-sage-dark transition-colors duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-sage after:transition-all after:duration-300 hover:after:w-full">Services</a>
        <a href="#testimonials" class="nav-link text-sm font-medium tracking-wide uppercase hover:text-sage-dark transition-colors duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-sage after:transition-all after:duration-300 hover:after:w-full">Reviews</a>
        <a href="#location" class="nav-link text-sm font-medium tracking-wide uppercase hover:text-sage-dark transition-colors duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-sage after:transition-all after:duration-300 hover:after:w-full">Visit Us</a>
        <a href="#contact" id="nav-cta" class="shimmer-btn ml-4 px-6 py-2.5 text-white text-sm font-semibold tracking-wide uppercase rounded-full shadow-lg shadow-sage/25 hover:shadow-xl hover:shadow-sage/30 transition-all duration-300 hover:-translate-y-0.5">Order Now</a>
      </div>

      <!-- Mobile Hamburger -->
      <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2 group" aria-label="Toggle menu">
        <span class="w-6 h-0.5 bg-charcoal transition-all duration-300 group-hover:bg-sage origin-center" id="hamburger-top"></span>
        <span class="w-6 h-0.5 bg-charcoal transition-all duration-300 group-hover:bg-sage" id="hamburger-mid"></span>
        <span class="w-4 h-0.5 bg-charcoal transition-all duration-300 group-hover:bg-sage group-hover:w-6 origin-center" id="hamburger-bot"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-white/95 backdrop-blur-xl border-t border-cream-dark">
    <div class="px-6 py-8 space-y-6">
      <a href="#flowers" class="mobile-link block text-lg font-medium tracking-wide hover:text-sage transition-colors">Our Flowers</a>
      <a href="#about" class="mobile-link block text-lg font-medium tracking-wide hover:text-sage transition-colors">About</a>
      <a href="#services" class="mobile-link block text-lg font-medium tracking-wide hover:text-sage transition-colors">Services</a>
      <a href="#testimonials" class="mobile-link block text-lg font-medium tracking-wide hover:text-sage transition-colors">Reviews</a>
      <a href="#location" class="mobile-link block text-lg font-medium tracking-wide hover:text-sage transition-colors">Visit Us</a>
      <a href="#contact" class="block shimmer-btn text-center px-6 py-3 text-white font-semibold rounded-full">Order Now</a>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-white/90', 'backdrop-blur-xl', 'shadow-lg', 'shadow-charcoal/5');
    } else {
      navbar?.classList.remove('bg-white/90', 'backdrop-blur-xl', 'shadow-lg', 'shadow-charcoal/5');
    }
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerTop = document.getElementById('hamburger-top');
  const hamburgerMid = document.getElementById('hamburger-mid');
  const hamburgerBot = document.getElementById('hamburger-bot');
  let isMenuOpen = false;

  menuBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    mobileMenu?.classList.toggle('hidden');

    if (isMenuOpen) {
      hamburgerTop?.classList.add('rotate-45', 'translate-y-[4px]');
      hamburgerMid?.classList.add('opacity-0');
      hamburgerBot?.classList.add('-rotate-45', '-translate-y-[4px]', 'w-6');
    } else {
      hamburgerTop?.classList.remove('rotate-45', 'translate-y-[4px]');
      hamburgerMid?.classList.remove('opacity-0');
      hamburgerBot?.classList.remove('-rotate-45', '-translate-y-[4px]', 'w-6');
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      isMenuOpen = false;
      hamburgerTop?.classList.remove('rotate-45', 'translate-y-[4px]');
      hamburgerMid?.classList.remove('opacity-0');
      hamburgerBot?.classList.remove('-rotate-45', '-translate-y-[4px]', 'w-6');
    });
  });
</script>
