---
// FlowerCard component for the flower grid
interface Props {
  name: string;
  image: string;
  price: string;
  description: string;
  badge?: string;
  delay?: number;
}

const { name, image, price, description, badge, delay = 0 } = Astro.props;
---

<div class="reveal group relative bg-white rounded-2xl overflow-hidden shadow-md shadow-charcoal/5 hover:shadow-2xl hover:shadow-sage/15 transition-all duration-500 hover:-translate-y-2" style={`transition-delay: ${delay}ms;`}>
  {badge && (
    <div class="absolute top-4 left-4 z-10 px-3 py-1 bg-gradient-to-r from-gold to-gold-light text-white text-xs font-bold tracking-wider uppercase rounded-full shadow-lg">
      {badge}
    </div>
  )}

  <!-- Image Container -->
  <div class="relative h-72 overflow-hidden">
    <img
      src={image}
      alt={`${name} flower`}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

    <!-- Quick action button -->
    <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500">
      <button class="w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-lg hover:bg-sage hover:text-white transition-all duration-300" aria-label={`Add ${name} to cart`}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Info -->
  <div class="p-6">
    <div class="flex items-start justify-between mb-2">
      <h3 class="font-serif text-xl font-semibold group-hover:text-sage-dark transition-colors duration-300">{name}</h3>
      <span class="text-sage-dark font-bold text-lg">{price}</span>
    </div>
    <p class="text-charcoal-light/70 text-sm leading-relaxed">{description}</p>

    <!-- Color dots (decorative) -->
    <div class="flex items-center gap-1.5 mt-4">
      <div class="w-3 h-3 rounded-full bg-blush border-2 border-blush-light"></div>
      <div class="w-3 h-3 rounded-full bg-sage border-2 border-sage-light"></div>
      <div class="w-3 h-3 rounded-full bg-lavender border-2 border-lavender/50"></div>
      <span class="text-xs text-charcoal-light/50 ml-1">+3 colors</span>
    </div>
  </div>
</div>
