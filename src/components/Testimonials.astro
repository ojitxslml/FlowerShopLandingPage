---
// Testimonials section
const testimonials = [
  {
    name: "Valentina Herrera",
    role: "Bride — Las Condes",
    content: "Pétale transformed our wedding into a floral paradise. The peony and rose arrangements were beyond anything I imagined. Every guest was in awe.",
    rating: 5,
    avatar: "VH"
  },
  {
    name: "Andrés Muñoz",
    role: "Corporate Client — Providencia",
    content: "We've been using Pétale's weekly subscription for our offices for over a year. The quality is consistently stunning, and our clients always comment on the flowers.",
    rating: 5,
    avatar: "AM"
  },
  {
    name: "Carolina Fuentes",
    role: "Regular Customer — Vitacura",
    content: "The orchid arrangement I received was a work of art. Same-day delivery, beautifully packaged, and the flowers lasted for weeks. Truly premium service.",
    rating: 5,
    avatar: "CF"
  },
];
---

<section id="testimonials" class="py-24 lg:py-32 bg-cream relative overflow-hidden">
  <!-- Decorative -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blush-light/10 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-sage text-sm font-medium tracking-[0.3em] uppercase">Testimonials</span>
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold mt-4 mb-6">
        What Our <span class="italic text-sage-dark">Clients</span> Say
      </h2>
      <p class="text-charcoal-light/70 text-lg max-w-2xl mx-auto leading-relaxed">
        Thousands of happy customers trust Pétale for life's most meaningful moments.
      </p>
      <div class="w-20 h-1 bg-gradient-to-r from-sage to-blush mx-auto mt-8 rounded-full"></div>
    </div>

    <!-- Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial, index) => (
        <div class="reveal bg-white rounded-2xl p-8 shadow-md shadow-charcoal/5 hover:shadow-xl hover:shadow-sage/10 transition-all duration-500 hover:-translate-y-1 relative" style={`transition-delay: ${index * 150}ms;`}>
          <!-- Quote mark -->
          <div class="absolute -top-4 left-8">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-sage to-sage-light flex items-center justify-center text-white shadow-lg shadow-sage/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
          </div>

          <!-- Stars -->
          <div class="flex gap-1 mb-4 mt-2">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <p class="text-charcoal-light/80 leading-relaxed mb-6 italic">"{testimonial.content}"</p>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-cream-dark">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-blush to-lavender flex items-center justify-center text-white font-bold text-sm">
              {testimonial.avatar}
            </div>
            <div>
              <p class="font-semibold text-sm">{testimonial.name}</p>
              <p class="text-charcoal-light/50 text-xs">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
